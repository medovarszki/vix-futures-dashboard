# Copy to .env.local (git-ignored)

# facade: live data from the IBKR Facade; mock (default): made up data
VITE_DATA_SOURCE=facade

# Where the dev server proxies /ibkr to. With the facade's docker-compose.expose.yml it is published on
# 127.0.0.1:8082 of the docker host.
FACADE_URL=http://localhost:8082

# The READ token of the facade (IBKR_SECURITY_READ_TOKEN), if its token authentication is enabled.
# It stays on the dev server, the browser never sees it. Never use the write token here.
FACADE_TOKEN=
